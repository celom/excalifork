rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{files}/rooms/{room}/{file} {
    	allow get, write: if true;
    }
    match /{files}/shareLinks/{shareLink}/{file} {
    	allow get, write: if true;
    }
    // Note: share-link scenes are not stored in Firebase at all — the
    // excalidraw-scenes service in docker-compose.selfhost.yml holds them on a
    // volume. Only images belonging to rooms and share links live in the two
    // paths above, which is why they were once the whole ruleset.

    // Per-user workspace payloads: scene blobs, image files, library.
    // The matches above are path-scoped, so they do not widen this one.
    match /users/{uid}/{allPaths=**} {
    	allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
