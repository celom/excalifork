rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Collab room persistence. Contents are encrypted in the browser with a
    // key that lives only in the URL fragment, so this holds opaque bytes and
    // knowing a room id is the only credential there is.
    //
    // This match is deliberately scoped to `/scenes/{roomId}` and NOT written
    // as a `/{document=**}` catch-all. Rules are a UNION: a permissive
    // catch-all would also match `/users/...` below and grant the world write
    // access to every signed-in user's workspace, silently defeating the
    // per-user rule no matter what that rule says.
    match /scenes/{roomId} {
      allow get, write: if true;
      // never set this to true, otherwise anyone can enumerate (and with the
      // write rule above, destroy) every room in the project.
      allow list: if false;
    }

    // Per-user workspace: scenes index, scene metadata, library metadata.
    // Unlike rooms, these are NOT end-to-end encrypted — see the "Per-user
    // storage is not end-to-end encrypted" section in README.md.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
